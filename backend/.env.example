# ---- Works with none of this: the app runs a full practice swarm offline. ----

# Database: SQLite by default; Postgres for production
DATABASE_URL=sqlite+aiosqlite:///./swarmdial.db
# DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/swarmdial

# Optional: Redis pub/sub for multi-process fan-out
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000

# ---- LLM brain for live calls (Groq Llama 3 70B or GPT-4o-mini; either speaks the OpenAI protocol) ----
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
# FORCE_SCRIPTED_AGENTS=false
# Backup model used when the main one keeps failing (e.g. Groq rate limits). Groq default: llama-3.3-70b-versatile (llama-3.1-8b-instant if that is the main model). Empty = off.
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# ---- Real phone calls ----
# PUBLIC_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# DEEPGRAM_API_KEY=
# DEFAULT: live mode phones real businesses found near the user's browser location (needs GOOGLE_PLACES_API_KEY).
# For private testing, set ALLOW_REAL_BUSINESS_CALLS=false and list DEMO_TARGETS; then ONLY those phones ring.
# DEMO_TARGETS=Teammate One:+15551230001;Teammate Two:+15551230002
# ALLOW_REAL_BUSINESS_CALLS=false
# REDIAL_COOLDOWN_MIN=30   # never call the same business twice within this many minutes
# MAX_CALLS_PER_DAY=150    # safety cap on live calls per day (0 = unlimited)
# Record calls to DEMO_TARGETS so you can replay them in the Twilio console (never applied to real businesses)
# RECORD_DEMO_CALLS=true
# GOOGLE_PLACES_API_KEY=

# ---- Tuning ----
# MAX_TARGETS=10
# BACKUP_TARGETS=6
# MAX_CONCURRENT_CALLS=12
# TARGET_YES_COUNT=4
# SIM_SPEED=1.0
